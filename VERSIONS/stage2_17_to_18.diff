 rxdvgate_msg:       db 10, 'Clearing RXDV_GATED_EN (MISC bit 19 @0xF0) -- unblocks RX at the PHY/MAC boundary...', 10, 0
+aldps_msg:          db 10, 'Disabling ALDPS (PHY page 0x0A43 reg0x10 bit2) -- prevents idle-link power-down...', 10, 0
