--- stage2_10.asm	2026-08-25 09:47:16.725281800 -0600
+++ stage2_11.asm	2026-08-25 09:47:16.741116900 -0600
@@ -1161,6 +1161,20 @@
 RX_DESC_BUF_SIZE   equ 0x3FFF   ; descriptor opts1 field value (14-bit max)
 RX_MAX_SIZE        equ 0x4000   ; RxMaxSize register value
 
+; Real multi-descriptor RX ring (round 11) -- replaces the single-descriptor
+; design that hung the whole machine on bursts as small as 5 unacked frames
+; (client fires faster than the CPU can drain+re-arm one descriptor, NIC has
+; nowhere to DMA the next frame). Each slot must still be the full 16KB
+; buffer round 5 already found this hardware requires (a smaller "just big
+; enough for one frame" buffer got zero RX activity at all) -- so the ring
+; is N separate 16KB buffers, not N smaller ones. Placed in the one clean
+; unused gap in the existing memory map (0x10000-0x20000, before the log
+; region at 0x20000-0x28000) -- doesn't move anything else.
+RX_RING_COUNT      equ 4
+RX_RING_BUF_ADDR   equ 0x10000   ; 4 * 0x4000 = 0x10000, ends exactly at
+                                  ; 0x20000 where LOG_LINEAR begins
+rx_cur: dd 0
+
 ; =============================================================================
 ; REMOTE_LOOP — persistent command loop. Replaces the one-shot RX echo
 ; test: instead of receiving one frame and halting, this re-arms the RX
@@ -1238,17 +1252,38 @@
     mov esi, remote_loop_hdr
     call print32
 
-.next_command:
-    ; ── Re-arm the RX descriptor: hand hardware a fresh empty buffer ──
+    ; ── One-time ring setup: arm all RX_RING_COUNT descriptors, each
+    ; pointing at its own 16KB buffer, EOR set only on the last one so the
+    ; NIC wraps back to descriptor 0. Done once here, not every iteration --
+    ; the ring persists; only the consumed slot gets re-armed per frame. ──
+    xor ecx, ecx
+.rx_ring_init:
     mov edi, RX_DESC_ADDR
+    mov eax, ecx
+    shl eax, 4
+    add edi, eax
+
     mov eax, 0x80000000
-    or  eax, 0x40000000
     or  eax, RX_DESC_BUF_SIZE
+    cmp ecx, RX_RING_COUNT - 1
+    jne .rx_init_not_last
+    or  eax, 0x40000000
+.rx_init_not_last:
     mov [edi], eax
     mov dword [edi+4], 0
-    mov dword [edi+8], RX_BUF_ADDR
+
+    mov eax, ecx
+    shl eax, 14
+    add eax, RX_RING_BUF_ADDR
+    mov [edi+8], eax
     mov dword [edi+12], 0
 
+    inc ecx
+    cmp ecx, RX_RING_COUNT
+    jne .rx_ring_init
+
+    mov dword [rx_cur], 0
+
     mov ebp, [mmio_base]
     mov dword [ebp+0xE4], RX_DESC_ADDR
     mov dword [ebp+0xE8], 0
@@ -1257,11 +1292,48 @@
     or al, 0x08
     mov [ebp+0x37], al
 
+.next_command:
 .wait_loop:
-    mov eax, [RX_DESC_ADDR]
+    mov edi, RX_DESC_ADDR
+    mov eax, [rx_cur]
+    shl eax, 4
+    add edi, eax
+    mov eax, [edi]
     test eax, 0x80000000
     jnz .wait_loop
 
+    ; Frame ready in ring slot [rx_cur] -- copy it into the fixed RX_BUF_ADDR
+    ; working buffer so every opcode handler below (unchanged, reads fixed
+    ; RX_BUF_ADDR+N offsets) keeps working exactly as before.
+    mov eax, [rx_cur]
+    shl eax, 14
+    add eax, RX_RING_BUF_ADDR
+    mov esi, eax
+    mov edi, RX_BUF_ADDR
+    mov ecx, 384        ; 1536 bytes -- comfortably covers the ~1507-byte max frame
+    rep movsd
+
+    ; Re-arm just this slot, then advance to the next one.
+    mov edi, RX_DESC_ADDR
+    mov eax, [rx_cur]
+    mov ebx, eax
+    shl eax, 4
+    add edi, eax
+    mov eax, 0x80000000
+    or  eax, RX_DESC_BUF_SIZE
+    cmp ebx, RX_RING_COUNT - 1
+    jne .rx_rearm_not_last
+    or  eax, 0x40000000
+.rx_rearm_not_last:
+    mov [edi], eax
+
+    inc dword [rx_cur]
+    mov eax, [rx_cur]
+    cmp eax, RX_RING_COUNT
+    jne .rx_cur_ok
+    mov dword [rx_cur], 0
+.rx_cur_ok:
+
     movzx eax, byte [RX_BUF_ADDR + 14]   ; opcode
     cmp al, 0x01
     je .do_read32
