+    call print32
+    mov eax, [remote_disk_drive]
+    call print_hex32
+    call emit_newline
+
     call remote_build_eth_header
     mov byte [TX_BUF_ADDR+14], 0x89
     mov al, [remote_disk_drive]
@@ -1601,6 +1611,11 @@
     cmp eax, 0xDEADC0DE
     jne .next_command
 
